{% comment %}
  Shukla Rugs — product detail rows (material / construction / dimensions / care /
  origin / story) plus shipping & returns policy links.

  Renders an accordion of product specification rows that mirror the Next.js
  product detail design. EVERY row is guarded: it is only output when a real
  value exists on the product's metafields (or, for shipping/returns, when a real
  store policy page is configured). Nothing here fabricates values — if a
  metafield or policy is absent, the corresponding row is simply omitted.

  Merchant-editable: this snippet is designed to be invoked from a `custom-liquid`
  block in templates/product.json. A merchant can change the metafield namespace
  or the individual keys below (they are plain assigns at the top) without a
  developer, then save in the theme editor's custom Liquid field.

  NOTE (needs verification during implementation): the metafield namespace and
  keys below (namespace `custom`; keys material, construction, dimensions,
  care_instructions, origin_region, product_story) follow the Shukla Rugs Next.js
  field names and the common Shopify `custom` namespace convention. The exact
  namespace/keys must be confirmed against the real Shopify store's metafield
  definitions; adjust the assigns below to match before relying on them in
  production. Until a key resolves to a real value, its row stays hidden.

  Usage (inside a custom-liquid block):
    {% render 'shukla-product-details', product: closest.product %}
{% endcomment %}

{%- liquid
  assign product = product | default: closest.product

  # ---- Merchant-editable metafield references -----------------------------
  # Change these to match the store's configured metafield definitions.
  assign ns = 'custom'
  assign material = product.metafields[ns].material
  assign construction = product.metafields[ns].construction
  assign dimensions = product.metafields[ns].dimensions
  assign care = product.metafields[ns].care_instructions
  assign origin = product.metafields[ns].origin_region
  assign story = product.metafields[ns].product_story
  # -------------------------------------------------------------------------

  assign has_specs = false
  if material != blank or construction != blank or dimensions != blank or origin != blank
    assign has_specs = true
  endif

  assign has_rows = false
  if has_specs or care != blank or story != blank
    assign has_rows = true
  endif

  # Only expose policy rows backed by real, configured store policy pages.
  assign shipping_policy = shop.policies.shipping_policy
  assign refund_policy = shop.policies.refund_policy
  assign has_policies = false
  if shipping_policy != blank or refund_policy != blank
    assign has_policies = true
  endif
-%}

{%- if has_rows or has_policies -%}
  <div class="shukla-product-details">
    {%- if story != blank -%}
      <details class="shukla-product-details__row">
        <summary class="shukla-product-details__summary">
          <span>{{ 'Product story' }}</span>
          <span class="svg-wrapper shukla-product-details__icon">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="shukla-product-details__content">{{ story | metafield_tag }}</div>
      </details>
    {%- endif -%}

    {%- if has_specs -%}
      <details class="shukla-product-details__row">
        <summary class="shukla-product-details__summary">
          <span>{{ 'Craft specifications' }}</span>
          <span class="svg-wrapper shukla-product-details__icon">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="shukla-product-details__content">
          <dl class="shukla-product-details__specs">
            {%- if material != blank -%}
              <div class="shukla-product-details__spec">
                <dt>{{ 'Material' }}</dt>
                <dd>{{ material | metafield_tag }}</dd>
              </div>
            {%- endif -%}
            {%- if construction != blank -%}
              <div class="shukla-product-details__spec">
                <dt>{{ 'Construction' }}</dt>
                <dd>{{ construction | metafield_tag }}</dd>
              </div>
            {%- endif -%}
            {%- if dimensions != blank -%}
              <div class="shukla-product-details__spec">
                <dt>{{ 'Dimensions' }}</dt>
                <dd>{{ dimensions | metafield_tag }}</dd>
              </div>
            {%- endif -%}
            {%- if origin != blank -%}
              <div class="shukla-product-details__spec">
                <dt>{{ 'Origin' }}</dt>
                <dd>{{ origin | metafield_tag }}</dd>
              </div>
            {%- endif -%}
          </dl>
        </div>
      </details>
    {%- endif -%}

    {%- if care != blank -%}
      <details class="shukla-product-details__row">
        <summary class="shukla-product-details__summary">
          <span>{{ 'Care &amp; maintenance' }}</span>
          <span class="svg-wrapper shukla-product-details__icon">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="shukla-product-details__content">{{ care | metafield_tag }}</div>
      </details>
    {%- endif -%}

    {%- if has_policies -%}
      <details class="shukla-product-details__row">
        <summary class="shukla-product-details__summary">
          <span>{{ 'Shipping &amp; returns' }}</span>
          <span class="svg-wrapper shukla-product-details__icon">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="shukla-product-details__content">
          <ul class="shukla-product-details__policies">
            {%- if shipping_policy != blank -%}
              <li><a href="{{ shipping_policy.url }}">{{ shipping_policy.title }}</a></li>
            {%- endif -%}
            {%- if refund_policy != blank -%}
              <li><a href="{{ refund_policy.url }}">{{ refund_policy.title }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      </details>
    {%- endif -%}
  </div>

  {% stylesheet %}
    .shukla-product-details {
      width: 100%;
    }

    .shukla-product-details__row {
      border-block-end: var(--style-border-width, 1px) solid var(--color-border, currentcolor);
    }

    .shukla-product-details__row:first-child {
      border-block-start: var(--style-border-width, 1px) solid var(--color-border, currentcolor);
    }

    .shukla-product-details__summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap-xs, 0.5rem);
      padding-block: var(--padding-md, 1rem);
      cursor: pointer;
      list-style: none;
      font-family: var(--font-heading--family);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--font-h6--size, 0.875rem);
    }

    .shukla-product-details__summary::-webkit-details-marker {
      display: none;
    }

    .shukla-product-details__icon {
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .shukla-product-details__row[open] .shukla-product-details__icon {
      transform: rotate(180deg);
    }

    .shukla-product-details__content {
      padding-block-end: var(--padding-lg, 1.5rem);
      font-family: var(--font-body--family);
      line-height: 1.6;
    }

    .shukla-product-details__specs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-md, 1rem);
      margin: 0;
    }

    .shukla-product-details__spec dt {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      opacity: 0.65;
      margin-block-end: 0.25rem;
    }

    .shukla-product-details__spec dd {
      margin: 0;
      font-weight: 500;
    }

    .shukla-product-details__policies {
      margin: 0;
      padding-inline-start: 1rem;
    }

    @media screen and (max-width: 749px) {
      .shukla-product-details__specs {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  {% endstylesheet %}
{%- endif -%}
