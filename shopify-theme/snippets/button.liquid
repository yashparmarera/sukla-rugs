{% assign button_label = label | default: 'Discover more' %}
{% if url != blank %}
  <a class="button button--{{ style | default: 'primary' }}" href="{{ url }}">{{ button_label | escape }}</a>
{% else %}
  <button class="button button--{{ style | default: 'primary' }}" type="{{ type | default: 'button' }}">{{ button_label | escape }}</button>
{% endif %}
