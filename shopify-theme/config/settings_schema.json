[
  {
    "name": "theme_info",
    "theme_name": "Shukla Rugs",
    "theme_version": "0.1.0",
    "theme_author": "Shukla Rugs",
    "theme_documentation_url": "https://help.shopify.com/en/manual/online-store/themes",
    "theme_support_email": "concierge@shuklarugs.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "SHUKLA RUGS"
      },
      {
        "type": "color",
        "id": "color_charcoal",
        "label": "Charcoal",
        "default": "#211D1B"
      },
      {
        "type": "color",
        "id": "color_ivory",
        "label": "Ivory",
        "default": "#F3ECE4"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream",
        "default": "#FAF7F2"
      },
      {
        "type": "color",
        "id": "color_terracotta",
        "label": "Champagne accent",
        "default": "#BC8A5A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "Display font",
        "default": "cormorant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1100,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "soft", "label": "Soft corners" }
        ],
        "default": "square"
      }
    ]
  },
  {
    "name": "Social links",
    "settings": [
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "pinterest_url",
        "label": "Pinterest"
      }
    ]
  }
]
