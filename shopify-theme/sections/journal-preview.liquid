<section class="home-journal page-width"><header class="home-section-header"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.blog != blank %}<a href="{{ section.settings.blog.url }}">{{ section.settings.link_label | escape }} →</a>{% endif %}</header>{% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}<div class="journal-grid">{% for article in section.settings.blog.articles limit: 3 %}<article class="journal-card"><a class="journal-card__image" href="{{ article.url }}">{% if article.image != blank %}{{ article.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}{% endif %}</a><div class="journal-card__content"><p class="journal-card__meta">{{ article.published_at | date: '%B %d, %Y' }}</p><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p><a class="journal-card__link" href="{{ article.url }}">Read article →</a></div></article>{% endfor %}</div>{% else %}<p class="home-empty">Select a Shopify blog in the Theme Editor to display the journal.</p>{% endif %}</section>

{% schema %}
{
  "name": "Journal preview",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Shukla Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories on craft & materiality" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read all journal articles" }
  ],
  "presets": [{ "name": "Journal preview" }]
}
{% endschema %}
