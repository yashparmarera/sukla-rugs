<section class="search-page page-width" data-search-page>
  <header class="search-page__header">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" data-predictive-search-form>
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">Search</label>
      <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" data-predictive-search-input>
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button button--primary" type="submit">Search</button>
    </form>
    <div class="predictive-search" data-predictive-results aria-live="polite"></div>
  </header>

  {% if search.performed %}
    {% paginate search.results by section.settings.results_per_page %}
      <div class="search-page__summary">
        <p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p>
      </div>
      {% if search.results_count > 0 %}
        <div class="product-grid search-results">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result, loading: 'lazy' %}
            {% else %}
              <article class="search-result-card">
                <p class="eyebrow">{{ result.object_type | escape }}</p>
                <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
                {% if result.content != blank %}<p>{{ result.content | strip_html | truncatewords: 22 }}</p>{% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="pagination" aria-label="Search pagination">
            {% if paginate.previous %}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{% endif %}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}<a href="{{ paginate.next.url }}" rel="next">Next</a>{% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="collection-empty">
          <h2>No results found</h2>
          <p>Try a different material, collection, room, or color.</p>
        </div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Search the catalogue" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your rug" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Search by collection, technique, material, or color" },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 6, "max": 36, "step": 3, "default": 12 }
  ]
}
{% endschema %}
