<section class="home-consultation"><div class="page-width home-consultation__inner"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p></div><div class="home-consultation__actions"><a class="button button--primary" href="{{ section.settings.primary_link | default: routes.root_url }}">{{ section.settings.primary_label | escape }} →</a><a href="{{ section.settings.secondary_link | default: routes.root_url }}">{{ section.settings.secondary_label | escape }}</a></div></div></section>

{% schema %}
{
  "name": "Consultation banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complimentary concierge & trade services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need assistance specifying the perfect rug?" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Whether you require custom dimensions, swatch samples, or room scale recommendations, our design specialists guide your selection step-by-step." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Book design consultation" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Find your rug" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Consultation banner" }]
}
{% endschema %}
