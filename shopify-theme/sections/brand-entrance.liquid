{% assign entrance_image_1 = section.settings.image_1 %}
{% assign entrance_image_2 = section.settings.image_2 %}
{% assign entrance_image_3 = section.settings.image_3 %}
{% assign entrance_image_4 = section.settings.image_4 %}

{% if section.settings.enabled %}
<section
  class="brand-entrance"
  data-brand-entrance
  data-home-path="{{ routes.root_url }}"
  data-session-key="shukla-entry-seen"
  data-slide-duration="2200"
  aria-label="{{ section.settings.aria_label | escape }}"
  aria-live="polite"
>
  <div class="brand-entrance__stage">
    <div class="brand-entrance__layer brand-entrance__layer--active" data-entrance-image data-index="0" aria-hidden="false">
      {% if entrance_image_1 != blank %}
        {{ entrance_image_1 | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image_1_alt }}
      {% else %}
        <img src="{{ 'hero-image1.webp' | asset_url }}" alt="{{ section.settings.image_1_alt | escape }}" width="2400" height="1600" loading="eager">
      {% endif %}
    </div>
    <div class="brand-entrance__layer" data-entrance-image data-index="1" aria-hidden="true">
      {% if entrance_image_2 != blank %}
        {{ entrance_image_2 | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image_2_alt }}
      {% else %}
        <img src="{{ '2-hero.webp' | asset_url }}" alt="{{ section.settings.image_2_alt | escape }}" width="2400" height="1600" loading="lazy">
      {% endif %}
    </div>
    <div class="brand-entrance__layer" data-entrance-image data-index="2" aria-hidden="true">
      {% if entrance_image_3 != blank %}
        {{ entrance_image_3 | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image_3_alt }}
      {% else %}
        <img src="{{ '3-hero.webp' | asset_url }}" alt="{{ section.settings.image_3_alt | escape }}" width="2400" height="1600" loading="lazy">
      {% endif %}
    </div>
    <div class="brand-entrance__layer" data-entrance-image data-index="3" aria-hidden="true">
      {% if entrance_image_4 != blank %}
        {{ entrance_image_4 | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: section.settings.image_4_alt }}
      {% else %}
        <img src="{{ '4-hero.webp' | asset_url }}" alt="{{ section.settings.image_4_alt | escape }}" width="2400" height="1600" loading="lazy">
      {% endif %}
    </div>
    <div class="brand-entrance__veil"></div>
  </div>

  <div class="brand-entrance__content page-width">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <div class="brand-entrance__rule"></div>
    <p class="brand-entrance__wordmark">{{ section.settings.wordmark | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="brand-entrance__description">{{ section.settings.description | escape }}</p>
    <a class="button button--light brand-entrance__cta" href="{{ section.settings.cta_link | default: routes.root_url }}" data-enter-website>
      <span>{{ section.settings.cta_label | escape }}</span>
      <span aria-hidden="true">↗</span>
    </a>
    {% if section.settings.disclaimer != blank %}
      <p class="brand-entrance__disclaimer"><span aria-hidden="true">✦</span> {{ section.settings.disclaimer | escape }}</p>
    {% endif %}
  </div>

  {% if section.settings.show_skip %}
    <button class="brand-entrance__skip" type="button" data-enter-website>
      {{ section.settings.skip_label | escape }} <span aria-hidden="true">→</span>
    </button>
  {% endif %}

  <div class="brand-entrance__controls" aria-label="Entrance slideshow controls">
    <button class="brand-entrance__arrow" type="button" data-entrance-previous aria-label="Previous entrance image">←</button>
    <div class="brand-entrance__progress" aria-live="polite">
      {% for index in (1..4) %}
        <span data-entrance-progress data-index="{{ forloop.index0 }}"{% if forloop.first %} class="is-active"{% endif %}></span>
      {% endfor %}
    </div>
    <button class="brand-entrance__arrow" type="button" data-entrance-next aria-label="Next entrance image">→</button>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Brand entrance",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable brand entrance", "default": true },
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Shukla Rugs brand entrance" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "text", "id": "image_1_alt", "label": "Image 1 alt text", "default": "Shukla Rugs handcrafted rug in a sunlit interior" },
    { "type": "text", "id": "image_2_alt", "label": "Image 2 alt text", "default": "Shukla Rugs handcrafted rug in a refined living space" },
    { "type": "text", "id": "image_3_alt", "label": "Image 3 alt text", "default": "Shukla Rugs handcrafted rug styled in a contemporary room" },
    { "type": "text", "id": "image_4_alt", "label": "Image 4 alt text", "default": "Shukla Rugs handcrafted rug in an elegant interior" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Handcrafted in Bhadohi · Designed for the world" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Shukla Rugs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We are crafting something special." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our new Shukla Rugs experience is coming soon." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "OPEN FULL WEBSITE" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "checkbox", "id": "show_skip", "label": "Show skip control", "default": true },
    { "type": "text", "id": "skip_label", "label": "Skip label", "default": "SKIP" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Disclaimer: Website under maintenance" }
  ]
}
{% endschema %}
