<section class="home-bhadohi">
  <div class="page-width home-bhadohi__grid">
    <div class="home-bhadohi__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.image_alt }}
      {% elsif section.settings.image_url != blank %}
        <img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.image_alt | escape }}" width="1200" height="1500" loading="lazy">
      {% endif %}
      <div class="home-bhadohi__badge"><p>{{ section.settings.badge_title | escape }}</p><span>{{ section.settings.badge_text | escape }}</span></div>
    </div>
    <div class="home-bhadohi__copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p class="home-bhadohi__lead">{{ section.settings.lead | escape }}</p><p>{{ section.settings.body | escape }}</p><div class="home-bhadohi__links"><a class="button button--accent" href="{{ section.settings.primary_link | default: routes.root_url }}">{{ section.settings.primary_label | escape }}</a><a href="{{ section.settings.secondary_link | default: routes.root_url }}">{{ section.settings.secondary_label | escape }} →</a></div></div>
  </div>
</section>

{% schema %}
{
  "name": "Bhadohi story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Artisan heritage · Uttar Pradesh, India" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bhadohi: The Heart of Indian Rug Weaving" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Centuries of craftsmanship flow through Bhadohi, where master weavers transform hand-spun wool and pure silk into enduring pieces of art." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every rug begins with natural raw materials and passes through hand-carding, natural vat-dyeing, precision warping, meticulous knotting, and sun washing." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Legacy image URL" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Master weaver tying knots in a Bhadohi loom house" },
    { "type": "text", "id": "badge_title", "label": "Badge title", "default": "Bhadohi Guild Standard" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Individually tied knots over dedicated hand weaving." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Explore the craft stages" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Our origin story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Bhadohi story" }]
}
{% endschema %}
