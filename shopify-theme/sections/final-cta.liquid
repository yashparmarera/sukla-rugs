<section class="home-final-cta page-width"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><div><a class="button button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a><a class="button button--outline" href="{{ section.settings.secondary_link | default: routes.root_url }}">{{ section.settings.secondary_label | escape }}</a></div></section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Handcrafted in Bhadohi" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Transform your architecture" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Discover handcrafted rugs made for considered living spaces around the world." },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop all rugs" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Find your rug" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
