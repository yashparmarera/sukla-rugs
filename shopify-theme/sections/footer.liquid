<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__lead">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p class="site-footer__statement">{{ section.settings.statement | escape }}</p>
        <p class="site-footer__contact">{{ section.settings.contact | escape }}</p>
      </div>
      <div class="site-footer__newsletter">
        <h3>{{ 'footer.newsletter_heading' | t }}</h3>
        <p>{{ 'footer.newsletter_text' | t }}</p>
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmail">{{ 'footer.email_placeholder' | t }}</label>
          <input id="FooterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'footer.email_placeholder' | t }}" required>
          <button type="submit" class="button button--accent">{{ 'footer.newsletter_submit' | t }}</button>
          {% if form.errors %}{{ form.errors | default_errors }}{% endif %}
          {% if form.posted_successfully? %}<p role="status">Thank you for joining the journal.</p>{% endif %}
        {% endform %}
      </div>
    </div>

    <div class="site-footer__navigation">
      {% for block in section.blocks %}
        <div class="site-footer__column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
          {% if block.type == 'menu' and block.settings.menu != blank %}
            <ul role="list">
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% elsif block.type == 'text' %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Handcrafted in Bhadohi, India.</p>
      <div class="site-footer__legal">
        <a href="{{ routes.privacy_policy_url }}">Privacy</a>
        <a href="{{ routes.terms_of_service_url }}">Terms</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Handcrafted luxury"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every rug tells a story."
    },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Statement",
      "default": "Handcrafted in Bhadohi, Uttar Pradesh and designed for living spaces around the world."
    },
    {
      "type": "text",
      "id": "contact",
      "label": "Contact line",
      "default": "Client concierge: concierge@shuklarugs.com"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Navigation column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Bhadohi" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Centuries of craftsmanship, woven for contemporary spaces.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Discover" } },
        { "type": "text", "settings": { "heading": "Bhadohi" } }
      ]
    }
  ]
}
{% endschema %}
