<section class="foundation-placeholder page-width">
  <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h1>{{ section.settings.heading | escape }}</h1>
  <div class="rte">{{ section.settings.body }}</div>
</section>

{% schema %}
{
  "name": "Foundation placeholder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bhadohi · India"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shukla Rugs"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The editable Shopify theme foundation is ready for homepage sections.</p>"
    }
  ],
  "presets": [
    { "name": "Foundation placeholder" }
  ]
}
{% endschema %}
