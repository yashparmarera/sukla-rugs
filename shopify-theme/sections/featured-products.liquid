<section class="home-featured page-width">
  {% assign featured_collection = section.settings.collection %}
  {% if featured_collection == blank %}{% assign featured_collection = collections.all %}{% endif %}
  <header class="home-section-header">
    <div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
    <a href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} →</a>
  </header>
  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="product-grid">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product, loading: 'lazy' %}
      {% endfor %}
    </div>
  {% else %}
    <p class="home-empty">Select a collection with published products in the Theme Editor.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signature curations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured loom releases" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all handcrafted rugs" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
