<section class="service-experience service-experience--{{ section.settings.tone }}" aria-labelledby="ServiceHeading-{{ section.id }}">
  <div class="page-width">
    <header class="service-experience__header">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 id="ServiceHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.intro != blank %}<p class="service-experience__intro">{{ section.settings.intro | escape }}</p>{% endif %}
    </header>

    <div class="service-experience__layout">
      <div class="service-experience__content rte">
        {{ section.settings.body }}
        {% if section.settings.form_mode == 'search' %}
          <form action="{{ routes.search_url }}" method="get" class="service-form service-form--search" role="search">
            <label for="ServiceSearch-{{ section.id }}">Search our collection</label>
            <div class="service-form__inline">
              <input id="ServiceSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Try “wool”, “vintage”, or a color" required>
              <button class="button button--accent" type="submit">Search rugs</button>
            </div>
          </form>
        {% elsif section.settings.form_mode == 'contact' %}
          {% form 'contact', class: 'service-form' %}
            {% if form.posted_successfully? %}
              <p class="service-form__message service-form__message--success" role="status">Thank you. Your note is with our concierge team, and we will be in touch shortly.</p>
            {% endif %}
            {% if form.errors %}
              <div class="service-form__message service-form__message--error" role="alert" tabindex="-1">
                <p>Please review the highlighted fields and try again.</p>
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
            <div class="service-form__fields">
              <div>
                <label for="ServiceName-{{ section.id }}">Name</label>
                <input id="ServiceName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required>
              </div>
              <div>
                <label for="ServiceEmail-{{ section.id }}">Email</label>
                <input id="ServiceEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required aria-describedby="ServiceEmailHelp-{{ section.id }}">
                <span id="ServiceEmailHelp-{{ section.id }}" class="service-form__hint">We only use this to reply to your enquiry.</span>
              </div>
              <div>
                <label for="ServicePhone-{{ section.id }}">Phone <span>(optional)</span></label>
                <input id="ServicePhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
              </div>
              <div>
                <label for="ServiceMessage-{{ section.id }}">How can we help?</label>
                <textarea id="ServiceMessage-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea>
              </div>
            </div>
            {% render 'button', label: section.settings.form_button, style: 'accent', type: 'submit' %}
          {% endform %}
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <aside class="service-experience__aside" aria-label="More about this service">
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              <article class="service-card" {{ block.shopify_attributes }}>
                <span class="service-card__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <div>
                  <h2>{{ block.settings.heading | escape }}</h2>
                  <p>{{ block.settings.text | escape }}</p>
                </div>
              </article>
            {% elsif block.type == 'link' and block.settings.link != blank %}
              <a class="service-card service-card--link" href="{{ block.settings.link }}">
                <div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p></div>
                <span aria-hidden="true">→</span>
              </a>
            {% endif %}
          {% endfor %}
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Service experience",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shukla Rugs services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A considered way to find your rug." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Personal guidance, honest materials, and a thoughtful pace." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Tell us what you are looking for and our team will help you take the next step.</p>" },
    { "type": "select", "id": "tone", "label": "Colour treatment", "default": "ivory", "options": [{ "value": "ivory", "label": "Ivory" }, { "value": "charcoal", "label": "Charcoal" }] },
    { "type": "select", "id": "form_mode", "label": "Form", "default": "none", "options": [{ "value": "none", "label": "No form" }, { "value": "search", "label": "Rug search" }, { "value": "contact", "label": "Contact enquiry" }] },
    { "type": "text", "id": "form_button", "label": "Form button label", "default": "Send enquiry" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Service step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Start with your space" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Share the details that matter to you." }
      ]
    },
    {
      "type": "link",
      "name": "Related link",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the collection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Browse rugs currently available." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Service experience", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
