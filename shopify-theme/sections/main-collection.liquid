<section class="collection-page page-width">
  <header class="collection-page__header">
    {% if section.settings.show_image and collection.image != blank %}
      <div class="collection-page__image">
        {{ collection.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '100vw', loading: 'eager', alt: collection.image.alt | default: collection.title }}
        <div class="collection-page__image-overlay"></div>
      </div>
    {% endif %}
    <div class="collection-page__intro{% if section.settings.show_image and collection.image != blank %} collection-page__intro--overlay{% endif %}">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}<div class="collection-page__description rte">{{ collection.description }}</div>{% endif %}
    </div>
  </header>

  <div class="collection-toolbar">
    <p>{{ collection.products_count }} {% if collection.products_count == 1 %}design{% else %}designs{% endif %}</p>
    <form method="get">
      <label for="SortBy-{{ section.id }}">Sort by</label>
      <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-layout">
      {% if collection.filters.size > 0 %}
        <aside class="collection-sidebar">
          {% render 'collection-filters', collection: collection %}
        </aside>
      {% endif %}

      <div class="collection-results">
        {% if collection.products.size > 0 %}
          <div class="product-grid" data-product-grid>
            {% for product in collection.products %}
              {% if forloop.index <= 3 %}
                {% render 'product-card', product: product, loading: 'eager' %}
              {% else %}
                {% render 'product-card', product: product, loading: 'lazy' %}
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="Pagination">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{% endif %}
              <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              {% if paginate.next %}<a href="{{ paginate.next.url }}" rel="next">Next</a>{% endif %}
            </nav>
          {% endif %}
        {% else %}
          <div class="collection-empty">
            <p class="eyebrow">No matching rugs</p>
            <h2>Nothing in this selection yet.</h2>
            <p>Clear the current filters or explore the full collection.</p>
            <a class="button button--primary" href="{{ collection.url }}">Clear filters</a>
          </div>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 6, "max": 36, "step": 3, "default": 12 }
  ]
}
{% endschema %}
