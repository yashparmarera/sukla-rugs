<section class="home-room-band">
  <div class="page-width">
    <header class="home-section-header"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} →</a></header>
    <div class="room-grid">
      {% for block in section.blocks %}
        <a class="room-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="room-card__image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 700, 1000, 1200', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title }}
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.title | escape }}" width="800" height="1000" loading="lazy">
            {% endif %}
            <div class="room-card__overlay"></div><div class="room-card__copy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.subtitle | escape }}</p></div>
          </div>
          <div class="room-card__recommendation"><span>{{ block.settings.recommendation | escape }}</span><span aria-hidden="true">→</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by room",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Architectural placement" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by space & scale" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore the size guide" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    { "type": "room", "name": "Room", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Living Room" },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Grounding anchors for grand and intimate seating areas" },
      { "type": "text", "id": "recommendation", "label": "Recommendation", "default": "Suggested: 8' x 10' or 9' x 12'" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_url", "label": "Legacy image URL" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Shop by room", "blocks": [{ "type": "room", "settings": { "title": "Living Room" } }, { "type": "room", "settings": { "title": "Bedroom", "subtitle": "Soft plush piles providing morning warmth barefoot" } }, { "type": "room", "settings": { "title": "Dining Room", "subtitle": "Low-profile weaves for smooth chair movement" } }, { "type": "room", "settings": { "title": "Entryway & Hallways", "subtitle": "Resilient runners and organic jute textures" } }] }]
}
{% endschema %}
