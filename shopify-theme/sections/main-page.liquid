<section class="editorial-page page-width">
  <header class="editorial-page__header">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ page.title | escape }}</h1>
  </header>
  <div class="editorial-page__content rte">
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Main page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shukla Rugs" }
  ]
}
{% endschema %}
