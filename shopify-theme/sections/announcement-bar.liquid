{% if section.settings.enabled and section.settings.text != blank %}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    <div class="page-width announcement-bar__inner">
      <p>{{ section.settings.text | escape }}</p>
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement",
      "default": "Complimentary global white-glove delivery on orders over $2,500"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Discover more"
    }
  ]
}
{% endschema %}
