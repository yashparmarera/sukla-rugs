{% assign current_product = product %}
{% assign related_collection = product.collections.first %}
{% if related_collection != blank and related_collection.products_count > 1 %}
  <section class="product-related page-width">
    <div class="product-related__header">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="product-grid">
      {% for related_product in related_collection.products limit: section.settings.products_to_show %}
        {% unless related_product.id == current_product.id %}
          {% render 'product-card', product: related_product, loading: 'lazy' %}
        {% endunless %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the same collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Continue exploring" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "presets": [
    { "name": "Related products" }
  ]
}
{% endschema %}
