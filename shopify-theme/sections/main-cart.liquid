<section class="cart-page page-width" data-cart-page>
  <header class="cart-page__header">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
  </header>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" data-cart-form>
      <ul class="cart-page__lines cart-lines" role="list">
        {% render 'cart-lines', cart: cart %}
      </ul>
      <div class="cart-page__summary">
        <div class="cart-total"><span>Subtotal</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div>
        <p>Taxes and shipping calculated at checkout.</p>
        <button class="button button--primary" type="submit" name="checkout">Proceed to checkout</button>
      </div>
    </form>
  {% else %}
    <div class="cart-empty cart-empty--page">
      <p>Your selection is currently empty.</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">Explore rugs</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A considered collection" }
  ]
}
{% endschema %}
